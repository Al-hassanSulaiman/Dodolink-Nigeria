{
  "image": "__IMAGE__",
  "containerPort": 8080,
  "awsLogsConfiguration": { "logGroup": "/ecs/dodolink", "logStreamPrefix": "ecs" },
  "environment": [
    { "name": "NODE_ENV", "value": "production" },
    { "name": "PORT", "value": "8080" },
    { "name": "TRUST_PROXY_HOPS", "value": "1" },
    { "name": "DATABASE_CONNECTION_MODE", "value": "url" },
    { "name": "MIGRATION_STAGING", "value": "false" },
    { "name": "MIGRATION_ALLOW_AUTH", "value": "false" },
    { "name": "MIGRATION_AUTH_PENDING", "value": "false" },
    { "name": "BACKGROUND_JOBS_ENABLED", "value": "false" },
    { "name": "STORAGE_PROVIDER", "value": "s3" },
    { "name": "AWS_REGION", "value": "__AWS_REGION__" },
    { "name": "PRIVATE_OBJECT_DIR", "value": "__PRIVATE_OBJECT_DIR__" },
    { "name": "PUBLIC_OBJECT_SEARCH_PATHS", "value": "__PUBLIC_OBJECT_SEARCH_PATHS__" },
    { "name": "WEB_FRONTEND_DIR", "value": "/app/web" },
    { "name": "NODE_EXTRA_CA_CERTS", "value": "/app/rds-global-bundle.pem" },
    { "name": "CLERK_AUTH_MODE", "value": "__CLERK_AUTH_MODE__" },
    { "name": "CLERK_PROXY_URL", "value": "__CLERK_PROXY_URL__" }
  ],
  "secrets": [
    { "name": "DATABASE_URL", "valueFrom": "__ARN_DATABASE_URL__" },
    { "name": "CLERK_SECRET_KEY", "valueFrom": "__ARN_CLERK_SECRET_KEY__" },
    { "name": "CLERK_PUBLISHABLE_KEY", "valueFrom": "__ARN_CLERK_PUBLISHABLE_KEY__" },
    { "name": "PAYSTACK_SECRET_KEY", "valueFrom": "__ARN_PAYSTACK_SECRET_KEY__" },
    { "name": "GMAIL_APP_PASSWORD", "valueFrom": "__ARN_GMAIL_APP_PASSWORD__" }
  ]
}
