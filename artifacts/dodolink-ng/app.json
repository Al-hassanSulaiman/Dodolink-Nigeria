{
  "expo": {
    "name": "Dodolink NG",
    "slug": "dodolink-ng",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dodolink-ng",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.dodolink.ng",
      "buildNumber": "15",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dodolink uses your photo library so you can upload product images for your store.",
        "NSPhotoLibraryAddUsageDescription": "Dodolink needs permission to save images to your photo library.",
        "NSCameraUsageDescription": "Dodolink uses your camera so you can take product photos directly.",
        "NSLocationWhenInUseUsageDescription": "Dodolink uses your location to show nearby stores and help customers find you.",
        "NSUserNotificationsUsageDescription": "Dodolink sends you notifications for new orders, messages, and store activity.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dodolink.ng",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withSpmNilFix",
      "@clerk/expo",
      "expo-apple-authentication",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dodolink uses your photo library so you can upload product images for your store.",
          "cameraPermission": "Dodolink uses your camera so you can take product photos directly."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dodolink uses your location to show nearby stores and help customers find you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1B5E20",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3e4ed22b-8363-4fff-9ee7-be8921e99e55"
      }
    },
    "owner": "alhassan_5star"
  }
}
