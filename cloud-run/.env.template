# ─────────────────────────────────────────────────────────────────────────────
# Dodolink NG — Environment variables for Cloud Run
# Store ALL of these in GCP Secret Manager, not as plain env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP Project ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── Database (Cloud SQL PostgreSQL) ──────────────────────────────────────────
# Cloud Run connects to Cloud SQL via Unix socket.
# Format: postgresql://USER:PASSWORD@localhost/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://dodolink:PASSWORD@localhost/dodolink?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# ── Clerk Auth (YOUR OWN Clerk account — see README) ─────────────────────────
# Create a Clerk app at https://clerk.com and copy your LIVE keys.
# Live keys start with pk_live_ and sk_live_
CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Paystack ─────────────────────────────────────────────────────────────────
# These are your existing live keys from Replit Secrets
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# Create a GCS bucket in your GCP project
DEFAULT_OBJECT_STORAGE_BUCKET_ID=dodolink-storage
PRIVATE_OBJECT_DIR=/dodolink-storage/private
PUBLIC_OBJECT_SEARCH_PATHS=/dodolink-storage/public
# Cloud Run service account email (for signed URLs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=dodolink-api-sa@PROJECT_ID.iam.gserviceaccount.com
