# Version control
.git
.gitignore

# Replit-specific
.replit
.replit-artifact
.local/
attached_assets/

# Dependencies (installed fresh in Docker)
node_modules/
**/node_modules/

# Build outputs
**/dist/
artifacts/dodolink-ng/static-build/

# Logs and debug
**/*.log
npm-debug.log*

# Secrets
.env
.env.*
!.env.template

# Dev tools
**/.eslintcache
**/.tsbuildinfo

# Expo / mobile (not part of the API server)
artifacts/dodolink-ng/
artifacts/mockup-sandbox/

# Test files
**/*.test.ts
**/*.spec.ts
